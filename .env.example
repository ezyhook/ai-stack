# Copied to .env by install.sh; empty keys are filled with random values.
# Never commit .env.

# Must match server.apiKey in config.yaml
LUMO_API_KEY=
OPEN_TERMINAL_API_KEY=

# Host ports (always bound to 127.0.0.1)
LUMO_PORT=3003
OPEN_TERMINAL_PORT=8000
OPEN_WEBUI_PORT=8080

# Image tags
# open-terminal: latest (~4 GB, full toolkit) | slim (~430 MB) | alpine (~230 MB)
OPEN_TERMINAL_TAG=latest
OPEN_WEBUI_TAG=main-slim
